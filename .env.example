# Copy to .env and set real values before running.
# NEVER commit a populated .env (it is gitignored).

# Database
DB_NAME=agentos
DB_USER=agentos
DB_PASSWORD=change-me-to-a-strong-password

# JWT — must be at least 256 bits (32+ chars) for HS256.
# Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-characters
